# Copie este archivo como .env y complete los valores.

# Nombre que aparece arriba del menú (también se puede cambiar desde el panel de administración).
BAR_NAME="Bar El Encuentro"

# Dirección pública del sitio. Es la que se imprime dentro de los QR. ¡Sin barra al final!
PUBLIC_URL="https://menu.mibar.com"

# Contraseña del panel de administración (mínimo 10 caracteres).
ADMIN_PASSWORD="cambie-esta-clave"

# PIN que usan los mozos para entrar al panel del personal (mínimo 4 dígitos).
STAFF_PIN="4321"

# Secreto para firmar las sesiones. Genere uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Puerto del servidor y carpeta de datos (base de datos + fotos).
PORT=3000
DATA_DIR="./data"

# Moneda y formato de precios.
CURRENCY="ARS"
LOCALE="es-AR"

# Segundos que el botón queda bloqueado después de llamar al mozo.
CALL_COOLDOWN_SECONDS=60

# Zona horaria para mostrar las horas en el panel del personal.
TZ="America/Argentina/Buenos_Aires"

# Cantidad de proxys delante de la app (1 si usa Caddy/nginx o un hosting como Render/Railway).
TRUST_PROXY=1
